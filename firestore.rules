rules_version = '2';

// Modelo: cada pessoa pertence a uma "Casa" (household). Dentro da casa existem
// membros com um papel ('dono' ou 'membro') e permissões por categoria
// (financas / investimentos), cada uma com ver/editar. O dono sempre tem
// acesso total. Estas funções são a garantia de segurança de verdade —
// não importa o que o app mostra na tela, o banco de dados só entrega ou
// aceita gravação se a regra abaixo permitir.
service cloud.firestore {
  match /databases/{database}/documents {

    function souMembro(casaId) {
      return exists(/databases/$(database)/documents/households/$(casaId)/membros/$(request.auth.uid));
    }
    function dadosDoMembro(casaId) {
      return get(/databases/$(database)/documents/households/$(casaId)/membros/$(request.auth.uid)).data;
    }
    function souDono(casaId) {
      return souMembro(casaId) && dadosDoMembro(casaId).papel == 'dono';
    }
    function podeVer(casaId, categoria) {
      return souDono(casaId) || (souMembro(casaId) && dadosDoMembro(casaId).permissoes[categoria].ver == true);
    }
    function podeEditar(casaId, categoria) {
      return souDono(casaId) || (souMembro(casaId) && dadosDoMembro(casaId).permissoes[categoria].editar == true);
    }
    // Existe um convite pendente para o e-mail de quem está logado, apontando
    // para esta Casa? É o que permite a pessoa entrar pela primeira vez —
    // sem isso ela nunca conseguiria virar membro (precisaria já ser membro
    // para poder se cadastrar como membro).
    function tenhoConvitePara(casaId) {
      return request.auth != null && request.auth.token.email != null
        && exists(/databases/$(database)/documents/convites/$(request.auth.token.email.lower()))
        && get(/databases/$(database)/documents/convites/$(request.auth.token.email.lower())).data.householdId == casaId;
    }

    // Perfil básico do usuário (aponta pra qual Casa ele pertence)
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Convites pendentes: quem tem aquele e-mail lê/aceita o próprio convite.
    // O dono da casa também pode ver e cancelar convites que ele mesmo criou.
    // Qualquer usuário logado pode CRIAR um convite (o app só mostra essa opção pro dono da casa).
    // Convites pendentes. O ID do documento é sempre o e-mail em minúsculas,
    // mas o e-mail do login pode vir com maiúsculas (o Firebase devolve como
    // a pessoa digitou no cadastro) — por isso a comparação normaliza os dois
    // lados. Sem isso, quem cadastrou "Fulano@Gmail.com" nunca acharia o
    // convite gravado como "fulano@gmail.com".
    function meuEmailNormalizado() {
      return request.auth != null && request.auth.token.email != null
        ? request.auth.token.email.lower() : '';
    }
    match /convites/{emailId} {
      allow read: if request.auth != null && (
        meuEmailNormalizado() == emailId.lower() ||
        souAdministrador() ||
        (resource != null && resource.data.householdId != null && souDono(resource.data.householdId))
      );
      // O convidado apaga o próprio convite ao aceitar/recusar; o dono da Casa
      // apaga ao cancelar.
      allow delete: if request.auth != null && (
        meuEmailNormalizado() == emailId.lower() ||
        souAdministrador() ||
        (resource != null && resource.data.householdId != null && souDono(resource.data.householdId))
      );
      // Criar ou reenviar um convite (o app usa set(), que vira update se já existir)
      allow create, update: if request.auth != null;
    }

    // E-mails que podem liberar assinaturas Premium manualmente.
    // Mantenha em sincronia com CONFIG_ASSINATURA.administradores no app.
    function souAdministrador() {
      return request.auth != null && request.auth.token.email in ['davipf57@gmail.com'];
    }

    // Assinaturas ficam FORA das Casas, indexadas pelo e-mail. Assim quem
    // administra as assinaturas nunca precisa (nem consegue) acessar os dados
    // financeiros de ninguém — só vê e-mail e data de validade.
    match /assinaturas/{emailId} {
      // Cada pessoa lê a própria assinatura; o admin lê todas. Qualquer pessoa
      // logada também pode consultar (somente leitura) a assinatura de outro
      // e-mail — é o que permite um convidado descobrir que a Casa em que ele
      // está é Premium. O documento só contém e-mail e data de validade, nada
      // sensível, e ninguém consegue alterá-lo.
      allow read: if request.auth != null;
      // Só o admin cria/edita/remove — ninguém consegue se dar Premium sozinho.
      allow write: if souAdministrador();
    }

    match /households/{casaId} {
      // Membros leem sempre; quem tem convite pendente também precisa ler,
      // porque o app mostra o nome da Casa na tela de aceitar o convite.
      allow read: if request.auth != null && (souMembro(casaId) || tenhoConvitePara(casaId));
      allow create: if request.auth != null;
      allow update: if request.auth != null && souDono(casaId);
      // O dono pode apagar a própria Casa (usado ao excluir a Casa ou a conta inteira)
      allow delete: if request.auth != null && souDono(casaId);

      match /membros/{uid} {
        allow read: if request.auth != null && (souMembro(casaId) || tenhoConvitePara(casaId));
        // O dono gerencia qualquer membro. A própria pessoa pode criar ou
        // remover o próprio registro — é assim que ela aceita um convite
        // (precisa ter um convite válido) ou sai da Casa por conta própria.
        allow write: if request.auth != null && (
          souDono(casaId) ||
          (request.auth.uid == uid && (souMembro(casaId) || tenhoConvitePara(casaId)))
        );
      }
      match /convitesPendentes/{emailId} {
        allow read: if request.auth != null && (souMembro(casaId) || tenhoConvitePara(casaId));
        // O dono cria e cancela convites. O convidado só pode apagar o convite
        // que é dele, no momento em que aceita — sem isso o aceite falha na
        // última etapa, depois de já ter entrado na Casa.
        allow write: if request.auth != null && souDono(casaId);
        allow delete: if request.auth != null && (
          souDono(casaId) || meuEmailNormalizado() == emailId.lower()
        );
      }

      match /config/{docId} {
        allow read: if request.auth != null && podeVer(casaId, 'financas');
        allow write: if request.auth != null && podeEditar(casaId, 'financas');
      }
      match /orcamento/{docId} {
        allow read: if request.auth != null && podeVer(casaId, 'financas');
        allow write: if request.auth != null && podeEditar(casaId, 'financas');
      }
      match /statusPagamento/{docId} {
        allow read: if request.auth != null && podeVer(casaId, 'financas');
        allow write: if request.auth != null && podeEditar(casaId, 'financas');
      }
      match /despesas/{docId} {
        allow read: if request.auth != null && podeVer(casaId, 'financas');
        allow write: if request.auth != null && podeEditar(casaId, 'financas');
      }
      match /compras/{docId} {
        allow read: if request.auth != null && podeVer(casaId, 'financas');
        allow write: if request.auth != null && podeEditar(casaId, 'financas');
      }
      match /dividas/{docId} {
        allow read: if request.auth != null && podeVer(casaId, 'financas');
        allow write: if request.auth != null && podeEditar(casaId, 'financas');
      }
      match /lixeira/{docId} {
        allow read: if request.auth != null && podeVer(casaId, 'financas');
        allow write: if request.auth != null && podeEditar(casaId, 'financas');
      }
      match /atividades/{docId} {
        allow read: if request.auth != null && souMembro(casaId);
        allow create: if request.auth != null && souMembro(casaId);
      }
      match /salarios/{docId} {
        allow read: if request.auth != null && podeVer(casaId, 'financas');
        allow write: if request.auth != null && podeEditar(casaId, 'financas');
      }
      match /investimentos/{docId} {
        allow read: if request.auth != null && podeVer(casaId, 'investimentos');
        allow write: if request.auth != null && podeEditar(casaId, 'investimentos');
      }
      match /metasInvestimento/{docId} {
        allow read: if request.auth != null && podeVer(casaId, 'investimentos');
        allow write: if request.auth != null && podeEditar(casaId, 'investimentos');
      }
    }
  }
}
